# Copy to .env and fill in after registering a SoundCloud app — see README.md "SoundCloud setup".
# There is no client secret here on purpose: SoundCloud's /oauth/token endpoint requires
# one even for PKCE, so it lives only in the Cloudflare Worker in /worker, never in this
# frontend. See README.md "SoundCloud token proxy" for deploying that Worker.

VITE_SOUNDCLOUD_CLIENT_ID=

# Must exactly match a redirect URI registered on the SoundCloud app. It points at
# the app's ROOT (not a "/callback" path — see src/lib/soundcloud/config.ts for why).
# Local dev:
VITE_SOUNDCLOUD_REDIRECT_URI=http://127.0.0.1:5173/guess-the-song/
# Production (GitHub Pages), once you know your final URL:
# VITE_SOUNDCLOUD_REDIRECT_URI=https://<your-username>.github.io/guess-the-song/

# The deployed Cloudflare Worker's URL (no trailing slash), e.g.
# https://guess-the-song-auth.<your-subdomain>.workers.dev — same value for local dev
# and production unless you deploy separate dev/prod Workers.
VITE_SOUNDCLOUD_TOKEN_PROXY_URL=
